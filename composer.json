{
    "name": "normahana/nh-core",
    "description": "Plugin central de Norma Hana (E-Commerce, Preferencias, Tracking, Integraciones)",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "autoload": {
        "psr-4": {
            "NormaHana\\Core\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NormaHana\\Core\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.11",
        "szepeviktor/phpstan-wordpress": "^1.3",
        "php-stubs/woocommerce-stubs": "^9.0",
        "squizlabs/php_codesniffer": "^3.8",
        "phpunit/phpunit": "^10.5"
    },
    "scripts": {
        "phpstan": "vendor/bin/phpstan analyse -c phpstan.neon",
        "check-style": "vendor/bin/phpcs --standard=.phpcs.xml src inc",
        "test": "vendor/bin/phpunit"
    }
}
